---
# ============================================================================
# Literate Monero User Configuration
# ============================================================================
#
# Edit these values BEFORE running the installation.
# This file is loaded by Ansible and should NOT be committed to git if you
# add sensitive information.
#
# After editing, run:
#   cd ansible
#   ansible-playbook validate.yml    # Check configuration
#   ansible-playbook playbook.yml    # Run installation

# ----------------------------------------------------------------------------
# Software Versions
# ----------------------------------------------------------------------------
# Check for latest releases:
#   Monerod: https://github.com/monero-project/monero/releases
#   P2Pool: https://github.com/SChernykh/p2pool/releases
#   XMRig: https://github.com/xmrig/xmrig/releases
#   Tor Browser: https://www.torproject.org/download/
#   Feather Wallet: https://github.com/feather-wallet/feather/releases
#   Trezor Suite: https://github.com/trezor/trezor-suite/releases
#   Haveno (RetoSwap): https://github.com/retoaccess1/haveno-reto/releases
#   Foundry (cast): https://github.com/foundry-rs/foundry/releases

# Note: getmonero.org hashes.txt only covers the current release, so fresh
# installs can only hash-verify the latest version.
monerod_version: "v0.18.5.0"
p2pool_version: "v4.16"
xmrig_version: "v6.25.0"
# Note: dist.torproject.org removes old releases, so fresh installs can
# only verify the current version.
tor_browser_version: "15.0.15"
feather_version: "2.8.1"
trezor_suite_version: "24.11.2"

# ----------------------------------------------------------------------------
# Required Configuration
# ----------------------------------------------------------------------------

# Your Monero wallet address (REQUIRED)
# Get from: getmonero.org, mymonero.com, Cake Wallet, etc.
# Must be 95 characters, starting with '4'
monero_wallet_address: "YOUR_WALLET_ADDRESS_HERE"

# ----------------------------------------------------------------------------
# User Accounts
# ----------------------------------------------------------------------------

# Your primary user account (created during Omarchy install as "dev")
# This user has desktop GUI access and operates anonymously by default
dev_user: dev

# SSH public key for remote access (paste your ~/.ssh/id_rsa.pub from client machine)
# Example: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAB... user@laptop"
dev_user_ssh_public_key: ""

mining_user: mining

# Sandboxed remote access (the sandbox phase). Operate the box from a laptop
# over WireGuard with the box's secrets kept invisible to the (laptop-side)
# agent. ops is the default sandboxed front door; dev is full contributor
# access. See docs/sandboxed-remote-access-handoff.md. Defaults live in
# group_vars (ops_access_enabled: true, dev_access_enabled: false).
#
# Laptop pubkey allowed to land as the sandboxed `ops` user. REQUIRED to enable
# ops access — the phase fails closed if this is empty. Use a DEDICATED key,
# distinct from dev_user_ssh_public_key.
ops_authorized_key: ""
# Uncomment to grant full on-box contributor access (installs on-box Claude).
# dev_access_enabled: true

# Git identity (anonymous/pseudonymous by default)
# Used for all git commits on this system
anon_git_name: "Your Pseudonym"
anon_git_email: "pseudo@protonmail.com"

# ----------------------------------------------------------------------------
# System Identity
# ----------------------------------------------------------------------------

system_hostname: anon-server
system_timezone: America/New_York
system_locale: en_US.UTF-8

# ----------------------------------------------------------------------------
# Mining Configuration
# ----------------------------------------------------------------------------

# Number of CPU threads for mining
# 0 = use all cores (recommended for dedicated mining)
# N = use N specific cores
# For mixed workload, consider: ansible_processor_vcpus - 2
mining_threads: 0

# P2Pool configuration
# Options: "normal", "mini", "nano"
# - normal: Main pool (for hashrate > 100 kH/s)
# - mini: For hashrate < 100 kH/s (most home systems)
# - nano: For very low hashrate (experimental)
p2pool_type: mini

# Mining priority (19 = lowest, won't interfere with other work)
mining_nice_priority: 19

# Enable huge pages for better performance
mining_huge_pages: true

# XMRig donation level. Stock builds enforce a 1% minimum: a value of 0
# is silently raised to 1 unless XMRig is built with the donate level
# patched out.
xmrig_donate_level: 1

# MSR access for XMRig (~5-15% faster RandomX, but grants the miner
# cap_sys_rawio and kernel MSR write access - hardware-level privilege
# for a network-facing workload). Off by default.
mining_msr_access: false

# ----------------------------------------------------------------------------
# Exchange Configuration (RetoSwap / Haveno) — optional, opt-in
# ----------------------------------------------------------------------------

# Anonymous, Tor-routed XMR <-> USDT trading via RetoSwap (the haveno-reto
# fork). OFF by default: with this false, the `exchange` phase is a complete
# no-op (nothing downloaded, no toolchain). Turn on ONLY if you understand the
# risks below, then deploy with: ansible-playbook playbook.yml --tags exchange -K
haveno_enabled: false

# RetoSwap release tag (no "v" prefix; the asset name's "v1.6.0" is derived
# automatically). PIN >= 1.6.0-reto: that release fixes the 2026-05 trade-
# protocol exploit (peer-identity verification). The signed AppImage is
# verified against keys/retoswap.asc before install.
haveno_version: "1.6.0-reto"

# Asset/rail (USDT on the TRON rail) are chosen at trade time in the GUI, so
# there is no config var for them. NOTE: the Haveno trade wallet holds HOT,
# at-risk funds — keep only working balance + open-trade deposits there.

# ----------------------------------------------------------------------------
# Interop Configuration (cast / Foundry) — optional, opt-in
# ----------------------------------------------------------------------------

# EVM-chain interop via `cast` (the Foundry CLI signer): receive, balances,
# transfers, and direct contract calls over Tor. The first tier BEYOND the
# Monero-native core. OFF by default: with this false the `interop` phase is a
# complete no-op (no binary, no toolchain). Turn on, then deploy with:
#   ansible-playbook playbook.yml --tags interop -K
cast_enabled: false

# Pinned Foundry release tag. Use a VERSIONED tag (vX.Y.Z) — the rolling
# `stable` tag omits the .sha256 + .sigstore.json this phase verifies against.
# Foundry publishes no GPG key; the binary is verified via cosign/Sigstore
# against a pinned certificate identity (see keys/README.md).
foundry_version: "v1.7.1"

# Optional documented default JSON-RPC endpoint. Leave blank and pass --rpc-url
# per call, OR set a NO-LOG endpoint here (e.g. https://1rpc.io/eth,
# PublicNode, LlamaRPC). No chain/asset is baked in — this is general infra.
cast_rpc_url: ""

# Remote-operator propose/approve signer (sandboxed remote access, PASS 2).
# Laptop-side Claude lands as `ops` and stages trades OFFLINE with `cast-propose`
# (no key, no network); you (the key owner) review, re-simulate over Tor and sign
# with `cast-approve`. The defaults in group_vars work as-is — uncomment only to
# tune custody or add trusted-side guardrails. NOTE: when enabling cast for the
# first time, deploy BOTH --tags sandbox (so the ops jail bind-mounts the spool)
# and --tags interop (which creates the spool and installs the signer).
# interop_custody_default: keystore   # keystore | trezor (airgap = future seam)
# interop_key_owner: dev              # defaults to dev_user; the uid that signs
# interop_to_allowlist: []            # if set, cast-approve refuses any other `to`
# interop_value_cap: ""               # max native value in wei cast-approve will sign

# Rabby browser-extension fallback — the dapp-UI path for the rare interaction
# that genuinely needs a web frontend (cast is the primary workhorse). Runs in a
# dedicated `wallet` Chromium profile on the fail-closed Mullvad path. OFF by
# default and INDEPENDENT of cast_enabled — you can run cast without it.
rabby_enabled: false

# Pinned Rabby release. Rabby publishes NO checksum and NO signature (inherent to
# the extension model — the Web Store, not the dev, signs the canonical .crx), so
# the SHA-256 below is a pin you set yourself: the phase downloads
# Rabby_<version>.zip, verifies it against this hash, fails closed on mismatch,
# then self-packs it into a signed .crx and force-installs it from a local
# file:// manifest (no Web Store round-trip).
#   NOTE: this is a CONSISTENCY CHECK, not a code audit. It stops a targeted swap
#   (you getting different bytes than everyone else); it does NOT protect against
#   an upstream compromise (a bad release shipped to all). The real safety
#   backstop is a hardware wallet — strongly recommended for this path.
# To bump: change both lines together and cross-check the hash over >1 path
# (clearnet + Tor) before pinning:
#   curl -L <release-zip-url> | sha256sum
# See keys/README.md for the trust anchor.
rabby_version: "v0.93.93"
rabby_sha256: "90414ede7551338ac7e29616c3f7debd71592a5a7651aed69d4ae7a34ffcac74"

# ----------------------------------------------------------------------------
# Backup Configuration
# ----------------------------------------------------------------------------

# Backup schedule (cron format: minute hour day month weekday)
backup_schedule: "0 3 * * *" # 3 AM daily

# How long to keep backups
backup_retention_days: 30

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# SSH configuration
ssh_port: 22

# Firewall ports to allow (in addition to SSH)
firewall_allowed_ports:
  - 22/tcp # SSH (always required)
  # Uncomment as needed:
  # - 80/tcp   # HTTP
  # - 443/tcp  # HTTPS
  # - 8080/tcp # Custom app

# ----------------------------------------------------------------------------
# Optional: Advanced Configuration
# ----------------------------------------------------------------------------

# Disk space alert threshold (percentage)
disk_alert_threshold: 90

# Log retention (days)
log_retention_days: 30

# ----------------------------------------------------------------------------
# Browser Profile Configuration
# ----------------------------------------------------------------------------

# Browser profiles for domain-based routing
# Each profile gets its own Chromium data directory at ~/.config/chromium/{profile_name}
# Domains not in any profile route to Tor Browser (privacy-first default)
browser_profiles:
  - name: kyc-identity
    domains:
      - chatgpt.com
      - claude.ai

  - name: mullvad-fallback
    domains: []
      # Add Tor-blocked domains here:
      # - cloudflare-blocked-site.com
      # - crypto-wallet-site.com
  # Add more profiles as needed:
  # - name: work-profile
  #   domains:
  #     - company-intranet.com
  #     - slack.com

# ----------------------------------------------------------------------------
# WireGuard Configuration
# ----------------------------------------------------------------------------

# WireGuard network configuration
wireguard_network: 10.8.0.0/24
wireguard_server_ip: 10.8.0.1
wireguard_port: 51820

# Close SSH port 22 after WireGuard is verified working
# IMPORTANT: Set to false initially, test WireGuard first, then set to true
# With wireguard_only=true, SSH only accessible via WireGuard tunnel
wireguard_only: false  # Change to true after testing WireGuard connectivity

# ----------------------------------------------------------------------------
# Monero Full Node Configuration
# ----------------------------------------------------------------------------

# monerod bandwidth limits
monerod_out_peers: 8        # Outgoing connections (4-8 recommended)
monerod_in_peers: 8         # Incoming connections (0 to disable, 4-8 to contribute)
monerod_limit_rate_up: 2048      # KB/s upload (0 = unlimited)
monerod_limit_rate_down: 8192    # KB/s download (0 = unlimited)

# monerod RPC configuration
monerod_rpc_bind_ip: 127.0.0.1  # Localhost only (security)
monerod_rpc_port: 18081         # Standard Monero RPC port
monerod_restricted_rpc: true    # Restrict RPC commands (security)

# Data directory for blockchain
monerod_data_dir: /opt/monerod
