# User configuration (may contain customizations)
/config.yml
!/config.yml.example

# Generated files (all from tangling org files)
ansible/**
!ansible/.gitkeep
configs/**
!configs/.gitkeep
scripts/**
!scripts/.gitkeep

# Emacs
*~
\#*\#
.#*
*.elc
auto-save-list
tramp
.\#*
.emacs.d/backups/

# Ansible runtime
*.retry
.ansible/
/tmp/ansible_facts

# Temporary
*.tmp
*.log
*.swp
*.swo

# Secrets
*vault*
*password*
*.pem
*.key

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db
.commit-msg

# Working notes — the private working-notes repo, symlinked in.
# No trailing slash: this is a symlink, and git treats a symlink as a file.
_notes

# Backstop for a note written next to source by reflex, out of habit.
*-handoff.md

# Claude Code: machine-local settings (skills under .claude/skills/ ARE tracked)
.claude/settings.local.json
